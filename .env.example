# ParkFlow Kenya - environment variables template.
# Copy to .env and fill in real values. .env is gitignored - never commit it.
# Both the Flask engine and Django read this file.

# Supabase (source-of-truth PostgreSQL)
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_KEY=your-supabase-publishable-key
# Preferred on the server: the service-role key (never ship it to a browser).
# When set it is used instead of SUPABASE_KEY.
# SUPABASE_SERVICE_KEY=your-supabase-service-role-key

# Django
DJANGO_SECRET_KEY=generate-a-long-random-string
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
FLASK_API_URL=http://localhost:5001

# Shared secret between Django and the Flask engine (sent as X-API-Key).
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
# Empty = the engine accepts unauthenticated calls (local dev only).
FLASK_API_KEY=

# Testing only: allow clients to choose the exit time (lets e2e_check.py
# simulate a 90-minute stay). Never enable in normal operation - it would
# let anyone back-date an exit to avoid the fee.
# PARKFLOW_ALLOW_EXIT_TIME_OVERRIDE=1
